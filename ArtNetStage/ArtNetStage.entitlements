<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App Sandbox DISABILITATO: serve per aprire liberamente il socket UDP 6454
         (anche broadcast) e per eseguire ifconfig tramite AppleScript. -->
    <key>com.apple.security.app-sandbox</key>
    <false/>
</dict>
</plist>
